# Copia este archivo a .env y rellena los dos valores.
# Salen del panel de Supabase: Project Settings -> API.
#
# Vite solo expone al navegador las variables con prefijo VITE_, y solo lee
# el .env al arrancar: si lo cambias, reinicia `npm run dev`.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Publica por diseño: viaja en el bundle y no concede mas permisos de los que
# dejen pasar las policies RLS.
VITE_SUPABASE_ANON_KEY=

# La service_role NO va aqui. Salta toda la seguridad de RLS y solo debe
# vivir como secreto de las Edge Functions (Supabase la inyecta sola).
